<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
		<!--
			Assimalign.Cohesion.* packages come from either:
			  1. The sibling cohesion checkout's local feed (../cohesion/_out/packages), appended
			     automatically via RestoreAdditionalProjectSources in
			     build/Targets/Build.References.Packages.targets when the folder exists
			     (inner-loop source).
			  2. The GitHub Packages staging feed (https://nuget.pkg.github.com/assimalign/index.json),
			     added dynamically in CI with GITHUB_TOKEN, or locally via:
			       dotnet nuget add source https://nuget.pkg.github.com/assimalign/index.json
			         [dash]n github [dash]u <user> [dash]p (gh auth token) [dashdash]store-password-in-clear-text
			     (requires the read:packages scope: gh auth refresh [dash]s read:packages)
			Published versions are immutable. Bump the central release floor to consume a newer line;
			never add credentials to this file. An exact CohesionSiblingPackageVersion selects a complete
			Install-Local .local pack set when the sibling feed exists.
		-->
	</packageSources>
</configuration>
