{
  "schema": "cohesion/plan/v1",
  "resource": "appa-database",
  "kind": "Database",
  "workload": {
    "kind": "StatefulSet",
    "replicas": 1,
    "stableIdentity": true,
    "gate": {
      "terminals": [
        "Running",
        "Failed",
        "Stopped"
      ],
      "satisfying": [
        "Running"
      ]
    },
    "stopGraceSeconds": 30
  },
  "container": {
    "name": "appa-database",
    "artifact": "self",
    "ports": [
      {
        "endpoint": "db",
        "containerPort": 5432,
        "protocol": "tcp"
      },
      {
        "endpoint": "admin",
        "containerPort": 8080,
        "protocol": "tcp"
      }
    ],
    "mounts": [
      {
        "mount": "data",
        "containerPath": "/var/lib/database",
        "kind": "Volume",
        "source": null
      }
    ],
    "environment": {
      "COHESION_APPLICATION": "appa",
      "COHESION_RESOURCE": "appa-database",
      "COHESION_ENVIRONMENT": "Development"
    },
    "probes": [
      {
        "role": "readiness",
        "endpoint": "admin",
        "kind": "Http",
        "value": "/readyz",
        "command": []
      }
    ]
  },
  "volumes": [
    {
      "name": "data",
      "kind": "Volume",
      "size": "10Gi",
      "perReplicaClaim": true
    }
  ],
  "services": [
    {
      "name": "appa-database-db",
      "endpoint": "db",
      "port": 5432,
      "protocol": "tcp",
      "headless": false,
      "governing": false
    },
    {
      "name": "appa-database-admin",
      "endpoint": "admin",
      "port": 8080,
      "protocol": "tcp",
      "headless": false,
      "governing": false
    },
    {
      "name": "appa-database-headless",
      "endpoint": null,
      "port": null,
      "protocol": "tcp",
      "headless": true,
      "governing": true
    }
  ],
  "exposures": [],
  "hints": {}
}
