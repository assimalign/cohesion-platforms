<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.ApplicationModel.Gateway.Kubernetes</RootNamespace>
		<Description>The gateway half of the Cohesion Kubernetes platform: deploys a gateway's resources to a cluster as Deployments and Services, receives the publications and renewals their instances make through Leases, and calls their control planes through the API server's pod proxy.</Description>
	</PropertyGroup>
	<ItemGroup>
		<CohesionPackageReference Include="Assimalign.Cohesion.ApplicationModel.Gateway" />
		<CohesionPackageReference Include="KubernetesClient" />
	</ItemGroup>
	<ItemGroup>
		<!-- The protocol both halves of the platform share, compiled from the instance half's folder. -->
		<Compile Include="..\..\Assimalign.Cohesion.ApplicationModel.Hosting.Kubernetes\shared\KubernetesProtocol.cs" Link="Internal\KubernetesProtocol.cs" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="Assimalign.Cohesion.ApplicationModel.Gateway.Kubernetes.Tests" />
	</ItemGroup>
</Project>
