<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Assimalign.Cohesion.ApplicationModel.Hosting.Kubernetes</RootNamespace>
		<Description>The instance half of the Cohesion Kubernetes platform: the gateway client a resource instance uses when its gateway runs it on Kubernetes. The instance publishes and renews through a Lease of its own in the cluster's API server, and serves its control plane on its pod's control-plane port, which the gateway calls through the API server's pod proxy.</Description>
	</PropertyGroup>
	<ItemGroup>
		<CohesionPackageReference Include="Assimalign.Cohesion.ApplicationModel.Hosting" />
		<CohesionPackageReference Include="KubernetesClient" />
	</ItemGroup>
	<ItemGroup>
		<!-- The protocol both halves of the platform share; the gateway half links the same file. -->
		<Compile Include="..\shared\KubernetesProtocol.cs" Link="Internal\KubernetesProtocol.cs" />
		<!-- The control-plane listener every instance half that serves its control plane over HTTP compiles;
		     linked source, so no platform package references another. -->
		<Compile Include="..\..\..\Shared\InstanceControlPlaneListener.cs" Link="Internal\InstanceControlPlaneListener.cs" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="Assimalign.Cohesion.ApplicationModel.Hosting.Kubernetes.Tests" />
	</ItemGroup>
</Project>
