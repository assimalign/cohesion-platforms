<Project>
    <!--
        Local inner-loop feed: when a sibling cohesion checkout has packed nupkgs
        (installer/scripts/Install-Local.ps1 or dotnet pack -> _out/packages), restore
        resolves Assimalign.Cohesion.* from it. Cohesion package releases are immutable:
        advance the release floor to consume a newer line, and never name a version that
        is absent from its feed. The Exists-guarded CohesionSiblingPackageVersion property
        is intentionally overridable so inner-loop builds can select the exact .local
        identity; CI and machines without the sibling checkout use the release floor.
    -->
    <PropertyGroup>
        <_CohesionSiblingFeed>$(CohesionRepositoryDirectory)..\cohesion\_out\packages</_CohesionSiblingFeed>
        <!-- Claude worktrees live at <repo>\.claude\worktrees\<name>; probe the outer checkout's sibling too. -->
        <_CohesionSiblingFeed Condition="!Exists('$(_CohesionSiblingFeed)')">$(CohesionRepositoryDirectory)..\..\..\..\cohesion\_out\packages</_CohesionSiblingFeed>
        <RestoreAdditionalProjectSources Condition="Exists('$(_CohesionSiblingFeed)')">$(RestoreAdditionalProjectSources);$(_CohesionSiblingFeed)</RestoreAdditionalProjectSources>

        <_CohesionPackageVersionFloor>[10.0.1-preview.3, )</_CohesionPackageVersionFloor>
        <_CohesionConsumedPackageVersion>$(_CohesionPackageVersionFloor)</_CohesionConsumedPackageVersion>
        <_CohesionConsumedPackageVersion Condition="Exists('$(_CohesionSiblingFeed)') AND '$(CohesionSiblingPackageVersion)' != ''">[$(CohesionSiblingPackageVersion)]</_CohesionConsumedPackageVersion>
    </PropertyGroup>

    <!-- #region Packages & Dependencies -->
    <ItemGroup>
        <!-- Cohesion packages consumed from the cohesion repo (GitHub Packages / sibling feed). -->
        <_CohesionPackage Include="Assimalign.Cohesion.Core" Version="$(_CohesionConsumedPackageVersion)" />
        <_CohesionPackage Include="Assimalign.Cohesion.ApplicationModel" Version="$(_CohesionConsumedPackageVersion)" />
        <_CohesionPackage Include="Assimalign.Cohesion.ApplicationModel.Gateway" Version="$(_CohesionConsumedPackageVersion)" />
    </ItemGroup>
    <ItemGroup>
        <_CohesionPackage Include="Sharprompt" Version="3.1.1" />
        <_CohesionPackage Include="KubernetesClient" Version="17.0.4" />
        <_CohesionPackage Include="NUlid" Version="1.7.2" />
        <_CohesionPackage Include="System.Threading.RateLimiting" Version="10.0.0"/>
        <_CohesionPackage Include="System.Security.Cryptography.Xml" Version="10.0.0" />
    </ItemGroup>

    <!-- Analyzer & Build Dependencies -->
    <ItemGroup>
        <_CohesionPackage Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" />
        <_CohesionPackage Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
        <_CohesionPackage Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0">
            <PrivateAssets>all</PrivateAssets>
        </_CohesionPackage>
        <_CohesionPackage Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.0.0">
            <PrivateAssets>all</PrivateAssets>
        </_CohesionPackage>
        <_CohesionPackage Include="Microsoft.Build" Version="18.7.1">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>all</ExcludeAssets>
        </_CohesionPackage>
        <_CohesionPackage Include="Microsoft.Build.Framework" Version="18.7.1">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>all</ExcludeAssets>
        </_CohesionPackage>
        <_CohesionPackage Include="Microsoft.Build.Utilities.Core" Version="18.7.1">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>all</ExcludeAssets>
        </_CohesionPackage>
        <_CohesionPackage Include="Microsoft.Build.Locator" Version="1.11.2" />
        <_CohesionPackage Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" Version="1.1.4" />
    </ItemGroup>

    <!-- XUnit Test Dependencies-->
    <ItemGroup>
        <_CohesionPackage Include="Shouldly" Version="4.3.0" />
        <_CohesionPackage Include="xunit" Version="2.9.3" />
        <_CohesionPackage Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
        <_CohesionPackage Include="xunit.runner.visualstudio" Version="3.1.5"
            IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"
            PrivateAssets="all" />
        <_CohesionPackage Include="coverlet.collector" Version="10.0.1">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </_CohesionPackage>
    </ItemGroup>

    <!-- PowerShell Binary Module Dependencies  -->
    <ItemGroup>
        <_CohesionPackage Include="System.Management.Automation" Version="7.6.0-preview.5" />
    </ItemGroup>

    <!-- #region: Package Reference Update -->
    <ItemGroup>
        <CohesionPackageReference Update="@(_CohesionPackage)" Version="%(_CohesionPackage.Version)" />
        <PackageReference Include="@(CohesionPackageReference)" />
        <CohesionPackageReference Remove="@(CohesionPackageReference)" />
    </ItemGroup>
    <!-- #endregion -->
</Project>
